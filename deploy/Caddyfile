# Phục vụ dist/ trong image FE. TLS, nén và /api do Caddy của cụm lo.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv

	# File trong assets/ có hash trong tên: cache lâu. File thiếu trả 404, để trình duyệt giữ bản cũ
	# thấy lỗi tải chunk thay vì nhận HTML.
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA (createBrowserRouter): đường dẫn không phải file thì trả index.html, luôn hỏi lại để nhận bản mới sau deploy.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
