# Base URL cho backend API (docs/21 mục 0). Để trống thì mặc định /api/v1
VITE_API_BASE_URL=

# Bật MSW (mock API). true = dùng dữ liệu giả, false = gọi backend thật
VITE_USE_MOCKS=true

# Client ID OAuth của Google Identity Services cho nút "Đăng nhập bằng Google" (docs/21 A6).
# Để trống thì nút bị khoá khi gọi backend thật; chạy mock không cần
VITE_GOOGLE_CLIENT_ID=

# Hiện nút "Đối soát ngay" khi gọi backend thật. Bật khi BE đã có POST /finance/settlements/run
# (commerio-backend#30 phần 2); chạy mock thì nút luôn hiện
VITE_SETTLEMENT_RUN=false
