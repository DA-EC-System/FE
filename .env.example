# Base URL cho backend API (docs/21 mục 0). Để trống thì mặc định /api/v1
VITE_API_BASE_URL=

# Client ID OAuth của Google Identity Services cho nút "Đăng nhập bằng Google" (docs/21 A6).
# Để trống thì nút bị khoá
VITE_GOOGLE_CLIENT_ID=

# Hiện nút "Đối soát ngay". Bật khi BE đã có POST /finance/settlements/run (commerio-backend#30 phần 2)
VITE_SETTLEMENT_RUN=false

# e2e/be (Playwright gọi BE thật, không phải biến của Vite): mã thử đăng ký công ty (commerio-backend#459,
# e2e/be/dangKy.ts). Cùng giá trị với REGISTRATION_TEST_EMAIL_DOMAIN, REGISTRATION_TEST_CODE của BE đang test; đặt trong
# shell hoặc .env.e2e.local, không commit giá trị.
# E2E_REGISTRATION_TEST_EMAIL_DOMAIN=
# E2E_REGISTRATION_TEST_CODE=

# Endpoint MCP server của agentation (ghi chú UI, #423); rỗng = http://localhost:4747
VITE_AGENTATION_ENDPOINT=
